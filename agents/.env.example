# Agent Customer Success — configuration
# Copier en .env et remplir

# === Provider LLM (choisir UN seul) ===
LLM_PROVIDER=mistral

# Mistral (recommandé : moins cher, FR)
# Inscription : https://console.mistral.ai
MISTRAL_API_KEY=

# OU Anthropic Claude (alternative qualité supérieure)
# Inscription : https://console.anthropic.com
ANTHROPIC_API_KEY=

# === Envoi d'emails ===
# Resend : 3000 emails/mois gratuits
# Inscription : https://resend.com
RESEND_API_KEY=
FROM_EMAIL=salih@telemetrie-fr.com
FROM_NAME=Salih

# === Base de données ===
DB_PATH=../backend/data/telemetry.db

# === Paramètres de l'agent ===
INACTIVE_DAYS=14
MAX_EMAILS_PER_RUN=20
