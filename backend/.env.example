# =========================================================
# Backend de télémétrie — configuration
# Copie ce fichier en .env et ajuste les valeurs.
# =========================================================

# --- Ports ---
HTTP_PORT=3000
MQTT_PORT=1883

# --- Sécurité ---
# Secret JWT (chaîne aléatoire longue) — génère avec : openssl rand -hex 32
JWT_SECRET=change-moi-pour-une-vraie-cle-aleatoire-32-octets

# Admin global (peut voir TOUTES les organisations)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# --- Stripe ---
# Récupère ces clés sur https://dashboard.stripe.com/apikeys
# En mode TEST : commencent par sk_test_ et pk_test_
# En mode LIVE  : sk_live_ et pk_live_
STRIPE_SECRET_KEY=sk_test_REMPLACE_MOI
STRIPE_PUBLISHABLE_KEY=pk_test_REMPLACE_MOI

# Secret du webhook (récupéré sur https://dashboard.stripe.com/webhooks)
# En local, utiliser : stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_REMPLACE_MOI

# IDs des prix Stripe (créés dans Dashboard Stripe → Produits)
# Voir docs/STRIPE.md pour la configuration
STRIPE_PRICE_STARTER=price_REMPLACE_starter
STRIPE_PRICE_PRO=price_REMPLACE_pro
STRIPE_PRICE_BUSINESS=price_REMPLACE_business

# --- URL publique de l'app (utilisée pour les redirections Stripe) ---
PUBLIC_URL=http://localhost:3000

# --- Base de données ---
DB_PATH=./data/telemetry.db
